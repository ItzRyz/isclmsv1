# Public — jangan taruh rahasia di sini
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — jangan commit nilai aslinya
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# DIRECT_URL=postgresql://user:password@localhost:5432/mydb
# Secret key (sb_secret_...) — server-only, bypass RLS, pengganti legacy service_role (deprecated akhir 2026).
# SUPABASE_SECRET_KEY=
# SENDER_API_KEY=
# SENDER_FROM_EMAIL=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
