    id               Uuid                   @id(map: "quizzes_pkey") @default(sql`gen_random_uuid()`)
    courseId         Uuid                   @map("course_id")
    moduleId         Uuid?                  @map("module_id")
    materialId       Uuid?                  @map("material_id")
    title            String
    description      String?
    _type            String                 @default("PRACTICE") @map("type")
    timeLimitSeconds Int?                   @map("time_limit_seconds")
    maxAttempts      Int                    @default(1) @map("max_attempts")
    shuffleQuestions Boolean                @default(false) @map("shuffle_questions")
    shuffleOptions   Boolean                @default(false) @map("shuffle_options")
    passingScore     Numeric?               @map("passing_score")
    isGraded         Boolean                @default(true) @map("is_graded")
    availableFrom    Timestamptz?           @map("available_from")
    dueAt            Timestamptz?           @map("due_at")
    status           pg.enum(ContentStatus) @default("DRAFT")
    createdBy        Uuid?                  @map("created_by")
    createdAt        Timestamptz            @default(now()) @map("created_at")
    updatedAt        Timestamptz            @default(now()) @map("updated_at")
    quizAttempts     QuizAttempts[]
    quizQuestions    QuizQuestions[]
    course           Courses                @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "quizzes_course_id_fkey")
    profiles         Profiles?              @relation(fields: [createdBy], references: [id], map: "quizzes_created_by_fkey", index: false)
    material         Materials?             @relation(fields: [materialId], references: [id], onDelete: SetNull, map: "quizzes_material_id_fkey", index: false)
    module           Modules?               @relation(fields: [moduleId], references: [id], onDelete: SetNull, map: "quizzes_module_id_fkey", index: false)

    @@index([courseId], map: "quizzes_course_id")
    @@check(expression: "(max_attempts >= 1)", map: "quizzes_max_attempts_check")
    @@check(expression: "((passing_score IS NULL) OR (passing_score >= (0)::numeric))", map: "quizzes_passing_score_check")
    @@check(expression: "((time_limit_seconds IS NULL) OR (time_limit_seconds > 0))", map: "quizzes_time_limit_seconds_check")
    @@rls
    @@map("quizzes")
  }

  model QuizAttempts {
    id            Uuid          @id(map: "quiz_attempts_pkey") @default(sql`gen_random_uuid()`)
    quizId        Uuid          @map("quiz_id")
    userId        Uuid          @map("user_id")
    attemptNumber Int           @map("attempt_number")
    startedAt     Timestamptz   @default(now()) @map("started_at")
    submittedAt   Timestamptz?  @map("submitted_at")
    score         Numeric?
    status        String        @default("IN_PROGRESS")
    createdAt     Timestamptz   @default(now()) @map("created_at")
    quizAnswers   QuizAnswers[]
    quiz          Quizzes       @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "quiz_attempts_quiz_id_fkey")
    user          Profiles      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "quiz_attempts_user_id_fkey")

    @@index([quizId], map: "quiz_attempts_quiz_id")
    @@index([userId], map: "quiz_attempts_user_id")
    @@check(expression: "(attempt_number >= 1)", map: "quiz_attempts_attempt_number_check")
    @@check(expression: "((score IS NULL) OR (score >= (0)::numeric))", map: "quiz_attempts_score_check")
    @@check(expression: "(status = ANY (ARRAY['IN_PROGRESS'::text, 'SUBMITTED'::text, 'GRADED'::text, 'EXPIRED'::text]))", map: "quiz_attempts_status_check")
    @@rls
    @@map("quiz_attempts")
  }

  model QuizAnswers {
    id                Uuid         @id(map: "quiz_answers_pkey") @default(sql`gen_random_uuid()`)
    attemptId         Uuid         @map("attempt_id")
    questionId        Uuid         @map("question_id")
    selectedOptionIds Jsonb        @default(json`[]`) @map("selected_option_ids")
    isCorrect         Boolean?     @map("is_correct")
    pointsAwarded     Numeric?     @map("points_awarded")
    answeredAt        Timestamptz  @default(now()) @map("answered_at")
    attempt           QuizAttempts @relation(fields: [attemptId], references: [id], onDelete: Cascade, map: "quiz_answers_attempt_id_fkey", index: false)
    question          Questions    @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "quiz_answers_question_id_fkey", index: false)

    @@unique([attemptId, questionId], map: "quiz_answers_attempt_id_question_id_key")
    @@check(expression: "((points_awarded IS NULL) OR (points_awarded >= (0)::numeric))", map: "quiz_answers_points_awarded_check")
    @@rls
    @@map("quiz_answers")
  }

  model QuizQuestions {
    quizId     Uuid      @map("quiz_id")
    questionId Uuid      @map("question_id")
    position   Int       @default(0)
    points     Numeric   @default(1)
    question   Questions @relation(fields: [questionId], references: [id], onDelete: Cascade, map: "quiz_questions_question_id_fkey", index: false)
    quiz       Quizzes   @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "quiz_questions_quiz_id_fkey", index: false)

    @@id([quizId, questionId], map: "quiz_questions_pkey")
    @@check(expression: "(points >= (0)::numeric)", map: "quiz_questions_points_check")
    @@rls
    @@map("quiz_questions")
  }

  model RankingPeriods {
    id               Uuid                   @id(map: "ranking_periods_pkey") @default(sql`gen_random_uuid()`)
    organizationId   Uuid                   @map("organization_id")
    academicPeriodId Uuid?                  @map("academic_period_id")
    _type            String                 @default("SEMESTER") @map("type")
    name             String
    startDate        Date?                  @map("start_date")
    endDate          Date?                  @map("end_date")
    metric           String                 @default("POINTS")
    status           pg.enum(ContentStatus) @default("DRAFT")
    createdAt        Timestamptz            @default(now()) @map("created_at")
    rankingEntries   RankingEntries[]
    academicPeriod   AcademicPeriods?       @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull, map: "ranking_periods_academic_period_id_fkey", index: false)
    organization     Organizations          @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "ranking_periods_organization_id_fkey", index: false)

    @@rls
    @@map("ranking_periods")
  }

  model RankingEntries {
    id              Uuid           @id(map: "ranking_entries_pkey") @default(sql`gen_random_uuid()`)
    rankingPeriodId Uuid           @map("ranking_period_id")
    userId          Uuid           @map("user_id")
    rank            Int
    score           Numeric
    points          Int            @default(0)
    createdAt       Timestamptz    @default(now()) @map("created_at")
    rankingPeriod   RankingPeriods @relation(fields: [rankingPeriodId], references: [id], onDelete: Cascade, map: "ranking_entries_ranking_period_id_fkey", index: false)
    user            Profiles       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "ranking_entries_user_id_fkey", index: false)

    @@unique([rankingPeriodId, userId], map: "ranking_entries_ranking_period_id_user_id_key")
    @@check(expression: "(rank >= 1)", map: "ranking_entries_rank_check")
    @@rls
    @@map("ranking_entries")
  }

  model ReportCards {
    id               Uuid              @id(map: "report_cards_pkey") @default(sql`gen_random_uuid()`)
    userId           Uuid              @map("user_id")
    academicPeriodId Uuid              @map("academic_period_id")
    totalScore       Numeric           @map("total_score")
    gradeLetter      String            @map("grade_letter")
    remark           String?
    publishedAt      Timestamptz?      @map("published_at")
    generatedAt      Timestamptz       @default(now()) @map("generated_at")
    reportCardItems  ReportCardItems[]
    academicPeriod   AcademicPeriods   @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade, map: "report_cards_academic_period_id_fkey", index: false)
    user             Profiles          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "report_cards_user_id_fkey", index: false)

    @@unique([userId, academicPeriodId], map: "report_cards_user_id_academic_period_id_key")
    @@rls
    @@map("report_cards")
  }

  model ReportCardItems {
    id               Uuid            @id(map: "report_card_items_pkey") @default(sql`gen_random_uuid()`)
    reportCardId     Uuid            @map("report_card_id")
    gradeComponentId Uuid            @map("grade_component_id")
    score            Numeric
    weight           Numeric         @default(0)
    weightedScore    Numeric         @default(0) @map("weighted_score")
    gradeComponent   GradeComponents @relation(fields: [gradeComponentId], references: [id], onDelete: Cascade, map: "report_card_items_grade_component_id_fkey", index: false)
    reportCard       ReportCards     @relation(fields: [reportCardId], references: [id], onDelete: Cascade, map: "report_card_items_report_card_id_fkey", index: false)

    @@rls
    @@map("report_card_items")
  }

  model Roadmaps {
    id           Uuid                   @id(map: "roadmaps_pkey") @default(sql`gen_random_uuid()`)
    divisionId   Uuid                   @map("division_id")
    name         String
    slug         String
    description  String?
    status       pg.enum(ContentStatus) @default("DRAFT")
    createdAt    Timestamptz            @default(now()) @map("created_at")
    updatedAt    Timestamptz            @default(now()) @map("updated_at")
    roadmapNodes RoadmapNodes[]
    division     Divisions              @relation(fields: [divisionId], references: [id], onDelete: Cascade, map: "roadmaps_division_id_fkey", index: false)

    @@unique([divisionId, slug], map: "roadmaps_division_id_slug_key")
    @@rls
    @@map("roadmaps")
  }

  model RoadmapNodes {
    id                       Uuid           @id(map: "roadmap_nodes_pkey") @default(sql`gen_random_uuid()`)
    roadmapId                Uuid           @map("roadmap_id")
    courseId                 Uuid?          @map("course_id")
    moduleId                 Uuid?          @map("module_id")
    materialId               Uuid?          @map("material_id")
    title                    String
    position                 Int            @default(0)
    x                        Int?
    y                        Int?
    createdAt                Timestamptz    @default(now()) @map("created_at")
    roadmapEdges             RoadmapEdges[] @relation(name: "roadmap_edges_from_node_id_fkey")
    roadmapEdgesRoadmapEdges RoadmapEdges[] @relation(name: "roadmap_edges_to_node_id_fkey")
    course                   Courses?       @relation(fields: [courseId], references: [id], onDelete: Cascade, map: "roadmap_nodes_course_id_fkey", index: false)
    material                 Materials?     @relation(fields: [materialId], references: [id], onDelete: Cascade, map: "roadmap_nodes_material_id_fkey", index: false)
    module                   Modules?       @relation(fields: [moduleId], references: [id], onDelete: Cascade, map: "roadmap_nodes_module_id_fkey", index: false)
    roadmap                  Roadmaps       @relation(fields: [roadmapId], references: [id], onDelete: Cascade, map: "roadmap_nodes_roadmap_id_fkey")

    @@index([roadmapId], map: "roadmap_nodes_roadmap_id")
    @@check(expression: "(((((course_id IS NOT NULL))::integer + ((module_id IS NOT NULL))::integer) + ((material_id IS NOT NULL))::integer) <= 1)", map: "roadmap_nodes_check")
    @@rls
    @@map("roadmap_nodes")
  }

  model RoadmapEdges {
    fromNodeId Uuid         @map("from_node_id")
    toNodeId   Uuid         @map("to_node_id")
    edgeType   String       @default("PREREQUISITE") @map("edge_type")
    fromNode   RoadmapNodes @relation(name: "roadmap_edges_from_node_id_fkey", fields: [fromNodeId], references: [id], onDelete: Cascade, map: "roadmap_edges_from_node_id_fkey", index: false)
    toNode     RoadmapNodes @relation(name: "roadmap_edges_to_node_id_fkey", fields: [toNodeId], references: [id], onDelete: Cascade, map: "roadmap_edges_to_node_id_fkey", index: false)

    @@id([fromNodeId, toNodeId], map: "roadmap_edges_pkey")
    @@check(expression: "(from_node_id <> to_node_id)", map: "roadmap_edges_check")
    @@rls
    @@map("roadmap_edges")
  }

  model Roles {
    id              Uuid              @id(map: "roles_pkey") @default(sql`gen_random_uuid()`)
    code            String            @unique(map: "roles_code_key")
    name            String
    description     String?
    isSystem        Boolean           @default(false) @map("is_system")
    createdAt       Timestamptz       @default(now()) @map("created_at")
    rolePermissions RolePermissions[]
    userRoles       UserRoles[]

    @@rls
    @@map("roles")
  }

  model RolePermissions {
    roleId       Uuid               @map("role_id")
    permissionId Uuid               @map("permission_id")
    scope        pg.enum(ScopeType)
    createdAt    Timestamptz        @default(now()) @map("created_at")
    permission   Permissions        @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "role_permissions_permission_id_fkey", index: false)
    role         Roles              @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "role_permissions_role_id_fkey", index: false)

    @@id([roleId, permissionId, scope], map: "role_permissions_pkey")
    @@rls
    @@map("role_permissions")
  }

  model Rubrics {
    id           Uuid          @id(map: "rubrics_pkey") @default(sql`gen_random_uuid()`)
    assignmentId Uuid          @map("assignment_id")
    name         String
    description  String?
    maxScore     Numeric       @default(100) @map("max_score")
    createdAt    Timestamptz   @default(now()) @map("created_at")
    rubricItems  RubricItems[]
    assignment   Assignments   @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "rubrics_assignment_id_fkey", index: false)

    @@check(expression: "(max_score > (0)::numeric)", map: "rubrics_max_score_check")
    @@rls
    @@map("rubrics")
  }

  model RubricItems {
    id          Uuid    @id(map: "rubric_items_pkey") @default(sql`gen_random_uuid()`)
    rubricId    Uuid    @map("rubric_id")
    criterion   String
    description String?
    maxPoints   Numeric @map("max_points")
    position    Int     @default(0)
    rubric      Rubrics @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "rubric_items_rubric_id_fkey", index: false)

    @@check(expression: "(max_points >= (0)::numeric)", map: "rubric_items_max_points_check")
    @@rls
    @@map("rubric_items")
  }

  model Submissions {
    id                  Uuid                  @id(map: "submissions_pkey") @default(sql`gen_random_uuid()`)
    assignmentId        Uuid                  @map("assignment_id")
    userId              Uuid?                 @map("user_id")
    assignmentGroupId   Uuid?                 @map("assignment_group_id")
    status              String                @default("DRAFT")
    textContent         String?               @map("text_content")
    submittedAt         Timestamptz?          @map("submitted_at")
    lastSavedAt         Timestamptz?          @map("last_saved_at")
    gradedAt            Timestamptz?          @map("graded_at")
    gradedBy            Uuid?                 @map("graded_by")
    score               Numeric?
    version             Int                   @default(1)
    createdAt           Timestamptz           @default(now()) @map("created_at")
    updatedAt           Timestamptz           @default(now()) @map("updated_at")
    submissionFeedbacks SubmissionFeedback[]
    submissionFiles     SubmissionFiles[]
    submissionRevisions SubmissionRevisions[]
    assignmentGroup     AssignmentGroups?     @relation(fields: [assignmentGroupId], references: [id], onDelete: Cascade, map: "submissions_assignment_group_id_fkey", index: false)
    assignment          Assignments           @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "submissions_assignment_id_fkey")
    profiles            Profiles?             @relation(name: "submissions_graded_by_fkey", fields: [gradedBy], references: [id], map: "submissions_graded_by_fkey", index: false)
    user                Profiles?             @relation(name: "submissions_user_id_fkey", fields: [userId], references: [id], onDelete: Cascade, map: "submissions_user_id_fkey")

    @@index([assignmentId], map: "submissions_assignment_id")
    @@index([userId], map: "submissions_user_id")
    @@check(expression: "((user_id IS NULL) <> (assignment_group_id IS NULL))", map: "submissions_check")
    @@check(expression: "(score >= (0)::numeric)", map: "submissions_score_check")
    @@check(expression: "(status = ANY (ARRAY['NOT_STARTED'::text, 'DRAFT'::text, 'SUBMITTED'::text, 'LATE'::text, 'GRADED'::text, 'REVISION_REQUIRED'::text, 'RESUBMITTED'::text]))", map: "submissions_status_check")
    @@check(expression: "(version >= 1)", map: "submissions_version_check")
    @@rls
    @@map("submissions")
  }

  model SubmissionFeedback {
    id           Uuid        @id(map: "submission_feedback_pkey") @default(sql`gen_random_uuid()`)
    submissionId Uuid        @map("submission_id")
    mentorId     Uuid        @map("mentor_id")
    body         String
    createdAt    Timestamptz @default(now()) @map("created_at")
    mentor       Profiles    @relation(fields: [mentorId], references: [id], map: "submission_feedback_mentor_id_fkey", index: false)
    submission   Submissions @relation(fields: [submissionId], references: [id], onDelete: Cascade, map: "submission_feedback_submission_id_fkey", index: false)

    @@rls
    @@map("submission_feedback")
  }

  model SubmissionFiles {
    id           Uuid        @id(map: "submission_files_pkey") @default(sql`gen_random_uuid()`)
    submissionId Uuid        @map("submission_id")
    bucket       String      @default("assignment-submissions")
    storagePath  String      @map("storage_path")
    originalName String      @map("original_name")
    mimeType     String      @map("mime_type")
    sizeBytes    BigInt      @map("size_bytes")
    checksum     String?
    createdAt    Timestamptz @default(now()) @map("created_at")
    submission   Submissions @relation(fields: [submissionId], references: [id], onDelete: Cascade, map: "submission_files_submission_id_fkey", index: false)

    @@unique([bucket, storagePath], map: "submission_files_bucket_storage_path_key")
    @@rls
    @@map("submission_files")
  }

  model SubmissionRevisions {
    id           Uuid        @id(map: "submission_revisions_pkey") @default(sql`gen_random_uuid()`)
    submissionId Uuid        @map("submission_id")
    version      Int
    textContent  String?     @map("text_content")
    submittedAt  Timestamptz @default(now()) @map("submitted_at")
    score        Numeric?
    status       String      @default("SUBMITTED")
    feedback     String?
    createdAt    Timestamptz @default(now()) @map("created_at")
    submission   Submissions @relation(fields: [submissionId], references: [id], onDelete: Cascade, map: "submission_revisions_submission_id_fkey", index: false)

    @@check(expression: "(score >= (0)::numeric)", map: "submission_revisions_score_check")
    @@rls
    @@map("submission_revisions")
  }

  model UserAchievements {
    userId        Uuid         @map("user_id")
    achievementId Uuid         @map("achievement_id")
    awardedAt     Timestamptz  @default(now()) @map("awarded_at")
    sourceType    String?      @map("source_type")
    sourceId      String?      @map("source_id")
    achievement   Achievements @relation(fields: [achievementId], references: [id], onDelete: Cascade, map: "user_achievements_achievement_id_fkey", index: false)
    user          Profiles     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_achievements_user_id_fkey", index: false)

    @@id([userId, achievementId], map: "user_achievements_pkey")
    @@rls
    @@map("user_achievements")
  }

  model UserDivisions {
    userId         Uuid         @map("user_id")
    divisionId     Uuid         @map("division_id")
    membershipType String       @default("MEMBER") @map("membership_type")
    startedAt      Timestamptz  @default(now()) @map("started_at")
    endedAt        Timestamptz? @map("ended_at")
    createdAt      Timestamptz  @default(now()) @map("created_at")
    division       Divisions    @relation(fields: [divisionId], references: [id], onDelete: Cascade, map: "user_divisions_division_id_fkey")
    user           Profiles     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_divisions_user_id_fkey")

    @@id([userId, divisionId], map: "user_divisions_pkey")
    @@index([divisionId], map: "user_divisions_division_id")
    @@index([userId], map: "user_divisions_user_id")
    @@rls
    @@map("user_divisions")
  }

  model UserRoles {
    userId     Uuid        @map("user_id")
    roleId     Uuid        @map("role_id")
    assignedBy Uuid?       @map("assigned_by")
    createdAt  Timestamptz @default(now()) @map("created_at")
    profiles   Profiles?   @relation(name: "user_roles_assigned_by_fkey", fields: [assignedBy], references: [id], map: "user_roles_assigned_by_fkey", index: false)
    role       Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "user_roles_role_id_fkey")
    user       Profiles    @relation(name: "user_roles_user_id_fkey", fields: [userId], references: [id], onDelete: Cascade, map: "user_roles_user_id_fkey")

    @@id([userId, roleId], map: "user_roles_pkey")
    @@index([roleId], map: "user_roles_role_id")
    @@index([userId], map: "user_roles_user_id")
    @@rls
    @@map("user_roles")
  }

  native_enum AccountStatus {
    ACTIVE = "ACTIVE"
    INACTIVE = "INACTIVE"
    SUSPENDED = "SUSPENDED"
    @@map("account_status")
  }

  native_enum ContentStatus {
    DRAFT = "DRAFT"
    PUBLISHED = "PUBLISHED"
    ARCHIVED = "ARCHIVED"
    @@map("content_status")
  }

  native_enum EntityStatus {
    ACTIVE = "ACTIVE"
    INACTIVE = "INACTIVE"
    ARCHIVED = "ARCHIVED"
    @@map("entity_status")
  }

  native_enum ScopeType {
    GLOBAL = "GLOBAL"
    ORGANIZATION = "ORGANIZATION"
    DIVISION = "DIVISION"
    CLASS = "CLASS"
    COURSE = "COURSE"
    OWN = "OWN"
    @@map("scope_type")
  }

  policy_select achievement_rules_select {
    target = AchievementRules
    roles = [authenticated]
    using = "true"
    @@map("achievement_rules_select")
  }

  policy_select achievements_select {
    target = Achievements
    roles = [authenticated]
    using = "true"
    @@map("achievements_select")
  }

  policy_delete announcements_delete {
    target = Announcements
    roles = [authenticated]
    using = "has_permission(auth.uid(), 'announcement.delete'::text)"
    @@map("announcements_delete")
  }

  policy_insert announcements_insert {
    target = Announcements
    roles = [authenticated]
    withCheck = "has_permission(auth.uid(), 'announcement.create'::text)"
    @@map("announcements_insert")
  }

  policy_select announcements_select {
    target = Announcements
    roles = [authenticated]
    using = "(((division_id IS NULL) AND (class_id IS NULL)) OR ((division_id IS NOT NULL) AND is_division_member(auth.uid(), division_id)) OR ((class_id IS NOT NULL) AND is_class_member(auth.uid(), class_id)) OR has_permission(auth.uid(), 'announcement.create'::text) OR has_permission(auth.uid(), 'announcement.update'::text))"
    @@map("announcements_select")
  }

  policy_update announcements_update {
    target = Announcements
    roles = [authenticated]
    using = "has_permission(auth.uid(), 'announcement.update'::text)"
    withCheck = "has_permission(auth.uid(), 'announcement.update'::text)"
    @@map("announcements_update")
  }

  policy_select assignment_group_members_select {
    target = AssignmentGroupMembers
    roles = [authenticated]
    using = "true"
    @@map("assignment_group_members_select")
  }

  policy_all assignment_group_members_write {
    target = AssignmentGroupMembers
    roles = [authenticated]
