    @@rls
    @@map("material_files")
  }

  model MaterialLinks {
    id         Uuid        @id(map: "material_links_pkey") @default(sql`gen_random_uuid()`)
    materialId Uuid        @map("material_id")
    url        String
    title      String?
    createdAt  Timestamptz @default(now()) @map("created_at")
    material   Materials   @relation(fields: [materialId], references: [id], onDelete: Cascade, map: "material_links_material_id_fkey", index: false)

    @@rls
    @@map("material_links")
  }

  model MaterialPrerequisites {
    materialId             Uuid      @map("material_id")
    prerequisiteMaterialId Uuid      @map("prerequisite_material_id")
    material               Materials @relation(name: "material_prerequisites_material_id_fkey", fields: [materialId], references: [id], onDelete: Cascade, map: "material_prerequisites_material_id_fkey", index: false)
    prerequisiteMaterial   Materials @relation(name: "material_prerequisites_prerequisite_material_id_fkey", fields: [prerequisiteMaterialId], references: [id], onDelete: Cascade, map: "material_prerequisites_prerequisite_material_id_fkey", index: false)

    @@id([materialId, prerequisiteMaterialId], map: "material_prerequisites_pkey")
    @@check(expression: "(material_id <> prerequisite_material_id)", map: "material_prerequisites_check")
    @@rls
    @@map("material_prerequisites")
  }

  model MaterialProgress {
    userId          Uuid         @map("user_id")
    materialId      Uuid         @map("material_id")
    startedAt       Timestamptz  @default(now()) @map("started_at")
    completedAt     Timestamptz? @map("completed_at")
    progressPercent Int          @default(0) @map("progress_percent")
    lastPosition    String?      @map("last_position")
    updatedAt       Timestamptz  @default(now()) @map("updated_at")
    material        Materials    @relation(fields: [materialId], references: [id], onDelete: Cascade, map: "material_progress_material_id_fkey", index: false)
    user            Profiles     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "material_progress_user_id_fkey", index: false)

    @@id([userId, materialId], map: "material_progress_pkey")
    @@check(expression: "((progress_percent >= 0) AND (progress_percent <= 100))", map: "material_progress_progress_percent_check")
    @@rls
    @@map("material_progress")
  }

  model NotificationPreferences {
    userId       Uuid        @map("user_id")
