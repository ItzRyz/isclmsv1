    latitude          Float?
    longitude         Float?
    radiusMeters      Int?                @map("radius_meters")
    sessionTokenHash  String?             @map("session_token_hash")
    status            String              @default("OPEN")
    createdBy         Uuid?               @map("created_by")
    createdAt         Timestamptz         @default(now()) @map("created_at")
    attendanceRecords AttendanceRecords[]
    class             Classes?            @relation(fields: [classId], references: [id], onDelete: Cascade, map: "attendance_sessions_class_id_fkey", index: false)
    profiles          Profiles?           @relation(fields: [createdBy], references: [id], map: "attendance_sessions_created_by_fkey", index: false)
    division          Divisions?          @relation(fields: [divisionId], references: [id], onDelete: Cascade, map: "attendance_sessions_division_id_fkey", index: false)

    @@check(expression: "(ends_at > starts_at)", map: "attendance_sessions_check")
