    profilesProfiles    Profiles?              @relation(name: "assignments_updated_by_fkey", fields: [updatedBy], references: [id], map: "assignments_updated_by_fkey", index: false)

    @@unique([courseId, slug], map: "assignments_course_id_slug_key")
    @@index([courseId], map: "assignments_course_id")
    @@index([dueAt], map: "assignments_due_at")
    @@check(expression: "((late_until IS NULL) OR (late_until >= due_at))", map: "assignments_check")
    @@check(expression: "(max_score > (0)::numeric)", map: "assignments_max_score_check")
    @@rls
    @@map("assignments")
  }

