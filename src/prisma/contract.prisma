// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model Organizations {
    id              Uuid              @id(map: "organizations_pkey") @default(sql`gen_random_uuid()`)
    name            String
    slug            String            @unique(map: "organizations_slug_key")
    description     String?
    logoPath        String?           @map("logo_path")
    createdAt       Timestamptz       @default(now()) @map("created_at")
    updatedAt       Timestamptz       @default(now()) @map("updated_at")
    academicPeriods AcademicPeriods[]
    batches         Batches[]
    divisions       Divisions[]

    @@rls
    @@map("organizations")
  }

  model AcademicPeriods {
    id             Uuid                  @id(map: "academic_periods_pkey") @default(sql`gen_random_uuid()`)
    organizationId Uuid                  @map("organization_id")
    name           String
    code           String                @unique(map: "academic_periods_code_key")
    startDate      Date?                 @map("start_date")
    endDate        Date?                 @map("end_date")
    status         pg.enum(EntityStatus) @default("ACTIVE")
    classes        Classes[]
    organization   Organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "academic_periods_organization_id_fkey", index: false)

    @@rls
    @@map("academic_periods")
  }

  // WARNING: Foreign key "id" -> "auth.users" exists in the database, but its target schema is outside the introspected scope, so no relation field was generated. If the target schema is described by an extension pack, add it to extensions and re-run infer.
  model Profiles {
    id                 Uuid                   @id(map: "profiles_pkey")
    fullName           String?                @map("full_name")
    username           String?                @unique(map: "profiles_username_key")
    studentNumber      String?                @unique(map: "profiles_student_number_key") @map("student_number")
    avatarPath         String?                @map("avatar_path")
    phone              String?
    status             pg.enum(AccountStatus) @default("ACTIVE")
    createdAt          Timestamptz            @default(now()) @map("created_at")
    updatedAt          Timestamptz            @default(now()) @map("updated_at")
    auditLogs          AuditLogs[]
    classMembers       ClassMembers[]
    userDivisions      UserDivisions[]
    userRoles          UserRoles[]            @relation(name: "user_roles_assigned_by_fkey")
    userRolesUserRoles UserRoles[]            @relation(name: "user_roles_user_id_fkey")

    @@rls
    @@map("profiles")
  }

  model AuditLogs {
    id         Uuid        @id(map: "audit_logs_pkey") @default(sql`gen_random_uuid()`)
    actorId    Uuid?       @map("actor_id")
    action     String
    entityType String      @map("entity_type")
    entityId   String?     @map("entity_id")
    oldValues  Jsonb?      @map("old_values")
    newValues  Jsonb?      @map("new_values")
    requestId  String?     @map("request_id")
    ipAddress  String?     @map("ip_address")
    userAgent  String?     @map("user_agent")
    createdAt  Timestamptz @default(now()) @map("created_at")
    actor      Profiles?   @relation(fields: [actorId], references: [id], map: "audit_logs_actor_id_fkey")

    @@index([actorId], map: "audit_logs_actor_id")
    @@index([entityType, entityId], map: "audit_logs_entity")
    @@rls
    @@map("audit_logs")
  }

  model Batches {
    id             Uuid                  @id(map: "batches_pkey") @default(sql`gen_random_uuid()`)
    organizationId Uuid                  @map("organization_id")
    name           String
    code           String                @unique(map: "batches_code_key")
    startDate      Date?                 @map("start_date")
    endDate        Date?                 @map("end_date")
    status         pg.enum(EntityStatus) @default("ACTIVE")
    classes        Classes[]
    organization   Organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "batches_organization_id_fkey", index: false)

    @@rls
    @@map("batches")
  }

  model Divisions {
    id             Uuid                  @id(map: "divisions_pkey") @default(sql`gen_random_uuid()`)
    organizationId Uuid                  @map("organization_id")
    name           String
    code           String                @unique(map: "divisions_code_key")
    slug           String                @unique(map: "divisions_slug_key")
    description    String?
    status         pg.enum(EntityStatus) @default("ACTIVE")
    createdAt      Timestamptz           @default(now()) @map("created_at")
    updatedAt      Timestamptz           @default(now()) @map("updated_at")
    classes        Classes[]
    userDivisions  UserDivisions[]
    organization   Organizations         @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "divisions_organization_id_fkey", index: false)

    @@rls
    @@map("divisions")
  }

  model Classes {
    id               Uuid                  @id(map: "classes_pkey") @default(sql`gen_random_uuid()`)
    divisionId       Uuid                  @map("division_id")
    batchId          Uuid?                 @map("batch_id")
    academicPeriodId Uuid?                 @map("academic_period_id")
    name             String
    code             String                @unique(map: "classes_code_key")
    capacity         Int?
    status           pg.enum(EntityStatus) @default("ACTIVE")
    createdAt        Timestamptz           @default(now()) @map("created_at")
    classMembers     ClassMembers[]
    academicPeriod   AcademicPeriods?      @relation(fields: [academicPeriodId], references: [id], map: "classes_academic_period_id_fkey", index: false)
    batch            Batches?              @relation(fields: [batchId], references: [id], map: "classes_batch_id_fkey", index: false)
    division         Divisions             @relation(fields: [divisionId], references: [id], onDelete: Cascade, map: "classes_division_id_fkey")

    @@index([divisionId], map: "classes_division_id")
    @@rls
    @@map("classes")
  }

  model ClassMembers {
    classId  Uuid                  @map("class_id")
    userId   Uuid                  @map("user_id")
    joinedAt Timestamptz           @default(now()) @map("joined_at")
    leftAt   Timestamptz?          @map("left_at")
    status   pg.enum(EntityStatus) @default("ACTIVE")
    class    Classes               @relation(fields: [classId], references: [id], onDelete: Cascade, map: "class_members_class_id_fkey")
    user     Profiles              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "class_members_user_id_fkey")

    @@id([classId, userId], map: "class_members_pkey")
    @@index([classId], map: "class_members_class_id")
    @@index([userId], map: "class_members_user_id")
    @@rls
    @@map("class_members")
  }

  model Permissions {
    id              Uuid              @id(map: "permissions_pkey") @default(sql`gen_random_uuid()`)
    code            String            @unique(map: "permissions_code_key")
    resource        String
    action          String
    description     String?
    createdAt       Timestamptz       @default(now()) @map("created_at")
    rolePermissions RolePermissions[]

    @@rls
    @@map("permissions")
  }

  model Roles {
    id              Uuid              @id(map: "roles_pkey") @default(sql`gen_random_uuid()`)
    code            String            @unique(map: "roles_code_key")
    name            String
    description     String?
    isSystem        Boolean           @default(false) @map("is_system")
    createdAt       Timestamptz       @default(now()) @map("created_at")
    rolePermissions RolePermissions[]
    userRoles       UserRoles[]

    @@rls
    @@map("roles")
  }

  model RolePermissions {
    roleId       Uuid               @map("role_id")
    permissionId Uuid               @map("permission_id")
    scope        pg.enum(ScopeType)
    createdAt    Timestamptz        @default(now()) @map("created_at")
    permission   Permissions        @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "role_permissions_permission_id_fkey", index: false)
    role         Roles              @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "role_permissions_role_id_fkey", index: false)

    @@id([roleId, permissionId, scope], map: "role_permissions_pkey")
    @@rls
    @@map("role_permissions")
  }

  model UserDivisions {
    userId         Uuid         @map("user_id")
    divisionId     Uuid         @map("division_id")
    membershipType String       @default("MEMBER") @map("membership_type")
    startedAt      Timestamptz  @default(now()) @map("started_at")
    endedAt        Timestamptz? @map("ended_at")
    createdAt      Timestamptz  @default(now()) @map("created_at")
    division       Divisions    @relation(fields: [divisionId], references: [id], onDelete: Cascade, map: "user_divisions_division_id_fkey")
    user           Profiles     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_divisions_user_id_fkey")

    @@id([userId, divisionId], map: "user_divisions_pkey")
    @@index([divisionId], map: "user_divisions_division_id")
    @@index([userId], map: "user_divisions_user_id")
    @@rls
    @@map("user_divisions")
  }

  model UserRoles {
    userId     Uuid        @map("user_id")
    roleId     Uuid        @map("role_id")
    assignedBy Uuid?       @map("assigned_by")
    createdAt  Timestamptz @default(now()) @map("created_at")
    profiles   Profiles?   @relation(name: "user_roles_assigned_by_fkey", fields: [assignedBy], references: [id], map: "user_roles_assigned_by_fkey", index: false)
    role       Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "user_roles_role_id_fkey")
    user       Profiles    @relation(name: "user_roles_user_id_fkey", fields: [userId], references: [id], onDelete: Cascade, map: "user_roles_user_id_fkey")

    @@id([userId, roleId], map: "user_roles_pkey")
    @@index([roleId], map: "user_roles_role_id")
    @@index([userId], map: "user_roles_user_id")
    @@rls
    @@map("user_roles")
  }

  native_enum AccountStatus {
    ACTIVE = "ACTIVE"
    INACTIVE = "INACTIVE"
    SUSPENDED = "SUSPENDED"
    @@map("account_status")
  }

  native_enum EntityStatus {
    ACTIVE = "ACTIVE"
    INACTIVE = "INACTIVE"
    ARCHIVED = "ARCHIVED"
    @@map("entity_status")
  }

  native_enum ScopeType {
    GLOBAL = "GLOBAL"
    ORGANIZATION = "ORGANIZATION"
    DIVISION = "DIVISION"
    CLASS = "CLASS"
    COURSE = "COURSE"
    OWN = "OWN"
    @@map("scope_type")
  }

