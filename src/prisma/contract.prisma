    @@check(expression: "((radius_meters IS NULL) OR (radius_meters > 0))", map: "attendance_sessions_radius_meters_check")
    @@check(expression: "(status = ANY (ARRAY['OPEN'::text, 'CLOSED'::text]))", map: "attendance_sessions_status_check")
    @@rls
    @@map("attendance_sessions")
  }

