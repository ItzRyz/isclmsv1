    @@id([userId, materialId], map: "material_bookmarks_pkey")
    @@rls
    @@map("material_bookmarks")
  }

  model MaterialFiles {
    id            Uuid        @id(map: "material_files_pkey") @default(sql`gen_random_uuid()`)
    materialId    Uuid        @map("material_id")
    storageBucket String      @map("storage_bucket")
    storagePath   String      @map("storage_path")
