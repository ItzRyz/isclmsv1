    description     String?
    isSystem        Boolean           @default(false) @map("is_system")
    createdAt       Timestamptz       @default(now()) @map("created_at")
    rolePermissions RolePermissions[]
    userRoles       UserRoles[]

    @@rls
    @@map("roles")
  }

  model RolePermissions {
    roleId       Uuid               @map("role_id")
    permissionId Uuid               @map("permission_id")
    scope        pg.enum(ScopeType)
    createdAt    Timestamptz        @default(now()) @map("created_at")
    permission   Permissions        @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "role_permissions_permission_id_fkey", index: false)
    role         Roles              @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "role_permissions_role_id_fkey", index: false)

    @@id([roleId, permissionId, scope], map: "role_permissions_pkey")
    @@rls
    @@map("role_permissions")
  }

  model Rubrics {
    id           Uuid          @id(map: "rubrics_pkey") @default(sql`gen_random_uuid()`)
    assignmentId Uuid          @map("assignment_id")
    name         String
    description  String?
    maxScore     Numeric       @default(100) @map("max_score")
    createdAt    Timestamptz   @default(now()) @map("created_at")
    rubricItems  RubricItems[]
    assignment   Assignments   @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "rubrics_assignment_id_fkey", index: false)

    @@check(expression: "(max_score > (0)::numeric)", map: "rubrics_max_score_check")
    @@rls
    @@map("rubrics")
  }

  model RubricItems {
    id          Uuid    @id(map: "rubric_items_pkey") @default(sql`gen_random_uuid()`)
    rubricId    Uuid    @map("rubric_id")
    criterion   String
    description String?
    maxPoints   Numeric @map("max_points")
    position    Int     @default(0)
    rubric      Rubrics @relation(fields: [rubricId], references: [id], onDelete: Cascade, map: "rubric_items_rubric_id_fkey", index: false)

    @@check(expression: "(max_points >= (0)::numeric)", map: "rubric_items_max_points_check")
    @@rls
    @@map("rubric_items")
  }

  model Submissions {
    id                  Uuid                  @id(map: "submissions_pkey") @default(sql`gen_random_uuid()`)
    assignmentId        Uuid                  @map("assignment_id")
    userId              Uuid?                 @map("user_id")
    assignmentGroupId   Uuid?                 @map("assignment_group_id")
    status              String                @default("DRAFT")
    textContent         String?               @map("text_content")
    submittedAt         Timestamptz?          @map("submitted_at")
    lastSavedAt         Timestamptz?          @map("last_saved_at")
    gradedAt            Timestamptz?          @map("graded_at")
    gradedBy            Uuid?                 @map("graded_by")
    score               Numeric?
    version             Int                   @default(1)
    createdAt           Timestamptz           @default(now()) @map("created_at")
    updatedAt           Timestamptz           @default(now()) @map("updated_at")
    submissionFeedbacks SubmissionFeedback[]
    submissionFiles     SubmissionFiles[]
    submissionRevisions SubmissionRevisions[]
    assignmentGroup     AssignmentGroups?     @relation(fields: [assignmentGroupId], references: [id], onDelete: Cascade, map: "submissions_assignment_group_id_fkey", index: false)
    assignment          Assignments           @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "submissions_assignment_id_fkey")
    profiles            Profiles?             @relation(name: "submissions_graded_by_fkey", fields: [gradedBy], references: [id], map: "submissions_graded_by_fkey", index: false)
    user                Profiles?             @relation(name: "submissions_user_id_fkey", fields: [userId], references: [id], onDelete: Cascade, map: "submissions_user_id_fkey")

    @@index([assignmentId], map: "submissions_assignment_id")
    @@index([userId], map: "submissions_user_id")
    @@check(expression: "((user_id IS NULL) <> (assignment_group_id IS NULL))", map: "submissions_check")
    @@check(expression: "(score >= (0)::numeric)", map: "submissions_score_check")
    @@check(expression: "(status = ANY (ARRAY['NOT_STARTED'::text, 'DRAFT'::text, 'SUBMITTED'::text, 'LATE'::text, 'GRADED'::text, 'REVISION_REQUIRED'::text, 'RESUBMITTED'::text]))", map: "submissions_status_check")
    @@check(expression: "(version >= 1)", map: "submissions_version_check")
    @@rls
    @@map("submissions")
  }

  model SubmissionFeedback {
    id           Uuid        @id(map: "submission_feedback_pkey") @default(sql`gen_random_uuid()`)
    submissionId Uuid        @map("submission_id")
    mentorId     Uuid        @map("mentor_id")
    body         String
    createdAt    Timestamptz @default(now()) @map("created_at")
    mentor       Profiles    @relation(fields: [mentorId], references: [id], map: "submission_feedback_mentor_id_fkey", index: false)
    submission   Submissions @relation(fields: [submissionId], references: [id], onDelete: Cascade, map: "submission_feedback_submission_id_fkey", index: false)

    @@rls
    @@map("submission_feedback")
  }

  model SubmissionFiles {
    id           Uuid        @id(map: "submission_files_pkey") @default(sql`gen_random_uuid()`)
    submissionId Uuid        @map("submission_id")
    bucket       String      @default("assignment-submissions")
    storagePath  String      @map("storage_path")
    originalName String      @map("original_name")
    mimeType     String      @map("mime_type")
    sizeBytes    BigInt      @map("size_bytes")
    checksum     String?
    createdAt    Timestamptz @default(now()) @map("created_at")
    submission   Submissions @relation(fields: [submissionId], references: [id], onDelete: Cascade, map: "submission_files_submission_id_fkey", index: false)

    @@unique([bucket, storagePath], map: "submission_files_bucket_storage_path_key")
    @@rls
    @@map("submission_files")
  }

  model SubmissionRevisions {
    id           Uuid        @id(map: "submission_revisions_pkey") @default(sql`gen_random_uuid()`)
    submissionId Uuid        @map("submission_id")
    version      Int
    textContent  String?     @map("text_content")
    submittedAt  Timestamptz @default(now()) @map("submitted_at")
    score        Numeric?
    status       String      @default("SUBMITTED")
    feedback     String?
    createdAt    Timestamptz @default(now()) @map("created_at")
    submission   Submissions @relation(fields: [submissionId], references: [id], onDelete: Cascade, map: "submission_revisions_submission_id_fkey", index: false)

    @@check(expression: "(score >= (0)::numeric)", map: "submission_revisions_score_check")
    @@rls
    @@map("submission_revisions")
  }

  model UserDivisions {
    userId         Uuid         @map("user_id")
    divisionId     Uuid         @map("division_id")
    membershipType String       @default("MEMBER") @map("membership_type")
    startedAt      Timestamptz  @default(now()) @map("started_at")
    endedAt        Timestamptz? @map("ended_at")
    createdAt      Timestamptz  @default(now()) @map("created_at")
    division       Divisions    @relation(fields: [divisionId], references: [id], onDelete: Cascade, map: "user_divisions_division_id_fkey")
    user           Profiles     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_divisions_user_id_fkey")

    @@id([userId, divisionId], map: "user_divisions_pkey")
    @@index([divisionId], map: "user_divisions_division_id")
    @@index([userId], map: "user_divisions_user_id")
    @@rls
    @@map("user_divisions")
  }

  model UserRoles {
    userId     Uuid        @map("user_id")
    roleId     Uuid        @map("role_id")
    assignedBy Uuid?       @map("assigned_by")
    createdAt  Timestamptz @default(now()) @map("created_at")
    profiles   Profiles?   @relation(name: "user_roles_assigned_by_fkey", fields: [assignedBy], references: [id], map: "user_roles_assigned_by_fkey", index: false)
    role       Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "user_roles_role_id_fkey")
    user       Profiles    @relation(name: "user_roles_user_id_fkey", fields: [userId], references: [id], onDelete: Cascade, map: "user_roles_user_id_fkey")

    @@id([userId, roleId], map: "user_roles_pkey")
    @@index([roleId], map: "user_roles_role_id")
    @@index([userId], map: "user_roles_user_id")
    @@rls
    @@map("user_roles")
  }

