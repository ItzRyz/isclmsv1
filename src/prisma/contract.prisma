    inAppEnabled Boolean     @default(true) @map("in_app_enabled")
    emailEnabled Boolean     @default(true) @map("email_enabled")
    updatedAt    Timestamptz @default(now()) @map("updated_at")
    user         Profiles    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "notification_preferences_user_id_fkey", index: false)

    @@id([userId, eventType], map: "notification_preferences_pkey")
    @@rls
    @@map("notification_preferences")
  }

  model Notifications {
    id          Uuid         @id(map: "notifications_pkey") @default(sql`gen_random_uuid()`)
